# Xerophis environment variables.
# Copy to `.env` and fill in. Real secrets must NEVER be committed.

# --- App ---
PUBLIC_URL=http://69.33.213.153
APP_VERSION=1.0.0

# --- Database (SQLite default; set DATABASE_URL for PostgreSQL) ---
# SQLite (default; local dev, zero-setup). Both DATA_DIR/DATABASE_FILE are optional.
DATA_DIR=./data
DATABASE_FILE=./data/xerophis.db
# UPLOAD_DIR=./data/uploads

# PostgreSQL (VPS production; requires prisma/schema.prisma + prisma client)
# DATABASE_URL=postgresql://xerophis:xerophis@localhost:5432/xerophis
# POSTGRES_PASSWORD=change-me

# --- Auth / sessions ---
AUTH_SECRET=change-me-please
SESSION_TTL_DAYS=30

# --- Realtime ---
REALTIME_PORT=3001
REDIS_URL= # optional

# --- Storage / uploads ---
UPLOAD_MAX_SIZE=26214400

# --- SMTP (password reset / verification) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@69.33.213.153

# --- WebRTC (future) ---
TURN_SERVER=
TURN_USERNAME=
TURN_PASSWORD=
