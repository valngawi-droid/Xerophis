# Xerophis environment — copy to .env and adjust
PORT=8080
HOST=0.0.0.0

# Email OTP (production wajib; tanpa ini mode dev menampilkan kode di log/respons)
# SMTP_URL=smtps://user:pass@smtp.host:465
# MAIL_FROM="Xerophis <no-reply@xerophis.app>"

# Storage adapter: sqlite (default) | postgres
DB_DRIVER=sqlite
# SQLite persistence path (adapter sqlite)
DB_PATH=./app/data/xerophis.db

# Production target (spec 08/71): adapter Postgres terverifikasi e2e.
# DATABASE_URL=postgres://xerophis:xerophis@db:5432/xerophis
# DB_DRIVER=postgres
