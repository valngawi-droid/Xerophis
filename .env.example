# Xerophis environment — copy to .env and adjust
PORT=8080
HOST=0.0.0.0

# SQLite persistence path (current adapter)
DB_PATH=./app/data/xerophis.db

# Production target (spec 08/71): Postgres adapter is the next milestone.
# When implemented, setting DATABASE_URL switches the storage layer.
# DATABASE_URL=postgres://xerophis:xerophis@db:5432/xerophis
